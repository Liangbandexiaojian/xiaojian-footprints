---
import '../styles/global.css';
import { withBase } from '../utils/paths';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '小謇的足迹',
  description = '行走、鸟鸣、教育与个人记录。'
} = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={withBase('/')} aria-label="回到首页">
        <span class="brand-mark"><img src={withBase('/images/brand/logo-mark.png')} alt="小謇的足迹 logo" /></span>
        <span>
          <strong>小謇的足迹</strong>
          <small>行走、鸟鸣与爱</small>
        </span>
      </a>
      <nav class="site-nav" aria-label="主导航">
        <a class="nav-main nav-publications" href={withBase('/articles/')}>公众号文章</a>
        <a class="nav-main nav-academic" href={withBase('/academic/')}>学术园地</a>
        <a class="nav-main nav-aesthetic" href={withBase('/aesthetic/')}>美的历程</a>
        <a class="nav-main nav-about" href={withBase('/about/')}>关于</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>© 小謇的足迹。本站收录公众号文章、个人研究、论文与摄影作品，并保留原始文本入口。</p>
    </footer>
  </body>
</html>
