---
import Layout from '../../layouts/Layout.astro';
import { aestheticPhotos } from '../../data/aesthetic';
import { withBase } from '../../utils/paths';
---
<Layout title="美的历程 | 小謇的足迹" description="小謇的摄影作品，只保留时间、地点与器材等记录信息。">
  <header class="page-title aesthetic-page-title">
    <p class="kicker">Photography</p>
    <h1>美的历程</h1>
    <p>小謇的摄影记录</p>
  </header>
  <section class="gallery-wrap" aria-label="摄影作品">
    <div class="gallery-grid">
      {aestheticPhotos.map((photo, index) => (
        <a class="photo-card" href={withBase(`/aesthetic/${photo.slug}/`)} aria-label={`查看 ${photo.location} 摄影作品`}>
          <img
            src={withBase(`/images/aesthetic/${photo.filename}`)}
            alt={`${photo.location} 摄影作品`}
            loading={index < 2 ? 'eager' : 'lazy'}
          />
          <span class="photo-caption">
            <span class="photo-location">{photo.location}</span>
            <span class="photo-info">{photo.dateLabel}</span>
            {photo.equipment && <span class="photo-camera">{photo.equipment}</span>}
          </span>
        </a>
      ))}
    </div>
  </section>
</Layout>
