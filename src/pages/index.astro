---
import Layout from '../layouts/Layout.astro';
import ArticleCover from '../components/ArticleCover.astro';
import { articles } from '../data/articles.generated';
import { categories, getCategory } from '../data/categories';

const sorted = [...articles].sort((a, b) => b.date.localeCompare(a.date));
const latest = sorted.slice(0, 6);
const counts = Object.fromEntries(categories.map((category) => [category.id, articles.filter((article) => article.category === category.id).length]));
const formatDate = (date: string) => new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }).format(new Date(`${date}T00:00:00+08:00`));
---
<Layout title="小謇的足迹" description="行走、鸟鸣、教育与个人记录。">
  <section class="hero">
    <div class="hero-copy">
      <p class="kicker">小謇的足迹</p>
      <h1><span>把行走、鸟鸣与爱</span><span>收进同一张地图</span></h1>
      <p class="hero-lede">这里保存已经发表过的文章：旅途中的思索、观鸟记录，以及关于成长与基础教育的私人档案。</p>
    </div>
    <div class="hero-media" aria-label="小謇的足迹首页照片">
      <img src="/images/profile/home-hero.jpg" alt="小謇的足迹首页照片" />
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <div>
        <h2>最新文章</h2>
      </div>
    </div>
    <div class="article-grid">
      {latest.map((article) => (
        <a class="article-card" href={`/articles/${article.slug}/`}>
          <ArticleCover article={article} variant="card" />
          <div class="article-card-body">
            <div class="card-meta">
              <span>{formatDate(article.date)}</span>
              <span>{getCategory(article.category).name}</span>
            </div>
            <h3>{article.title}</h3>
            <p>{article.summary}</p>
          </div>
        </a>
      ))}
    </div>
    <div class="section-action">
      <a class="button-link primary" href="/articles/">浏览所有文章</a>
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <div>
        <h2>合集</h2>
      </div>
    </div>
    <div class="category-grid">
      {categories.map((category, index) => (
        <a class="category-card" href={`/categories/${category.id}/`}>
          <span class="number">{String(index + 1).padStart(2, '0')}</span>
          <h3>{category.name}</h3>
          <p>{category.intro}</p>
          <p class="article-count">{counts[category.id]} 篇文章</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
