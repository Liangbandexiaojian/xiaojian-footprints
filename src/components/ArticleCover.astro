---
import { getArticleCover } from '../data/articleCovers';
import { getCategory } from '../data/categories';

interface Props {
  article: {
    title: string;
    slug: string;
    category: string;
    featureImage: string;
  };
  variant?: 'card' | 'list' | 'hero';
}

const { article, variant = 'card' } = Astro.props;
const cover = getArticleCover(article);
const category = getCategory(article.category);
const loading = variant === 'hero' ? 'eager' : 'lazy';
---
{cover.type === 'image' ? (
  <img src={cover.src} alt={article.title} loading={loading} />
) : (
  <div class:list={['quote-cover', `quote-cover-${variant}`]} aria-label={`${article.title} 文字封面`}>
    <p>{cover.quote}</p>
    <span>{cover.label || category.name}</span>
  </div>
)}
